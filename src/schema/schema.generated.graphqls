directive @cacheControl(inheritMaxAge: Boolean, maxAge: Int, scope: CacheControlScope) on FIELD_DEFINITION | INTERFACE | OBJECT | UNION

enum CacheControlScope {
  PRIVATE
  PUBLIC
}

input CreatePostInput {
  authorAddress: String!
  cid: String!
  content: String
  description: String!
  media: [MediaAttachmentInput!]
  quoteOf: String
  replyTo: String
  title: String!
  visibility: VisibilitySetting!
}

scalar Date

"""ISO‑8601 Date‑Time string (e.g. 2024‑04‑17T15:22:00.000Z)"""
scalar DateTime

input FilterInput {
  limit: Int
  offset: Int
}

scalar JSON

"""An attachment in a post."""
type MediaAttachment {
  cid: String
  id: String
  title: String
  type: MediaType!
  url: String
}

input MediaAttachmentInput {
  cid: String
  title: String
  type: MediaType!
  url: String
}

enum MediaType {
  AUDIO
  IMAGE
  VIDEO
}

type Mutation {
  createPost(input: CreatePostInput!): Post!
  createUser(input: UserInput!): User!
  deletePost(postId: String!): Boolean!
  incrementPostView(postId: String!): Post!
  updatePost(input: UpdatePostInput!): Post!
  updateUser(input: UpdateUserInput!): User!
}

"""A user’s post/publication."""
type Post {
  author: User!
  bookmarkCount: Int!
  cid: String!
  commentCount: Int!
  content: String!
  createdAt: Timestamp!
  description: String!
  id: String!
  likeCount: Int!
  media: [MediaAttachment!]
  quoteOf: Post
  replyTo: Post
  title: String!
  updatedAt: Timestamp
  viewCount: Int!
  visibility: VisibilitySetting!
}

type Query {
  getPost(id: String!): Post
  getPostsByAuthor(author: String!, limit: Int): [Post!]!
  getUser(address: String!): User
  getUserBookmarks(address: String!, limit: Int): [Post!]!
  getUserFollowers(address: String!, limit: Int): [User!]!
  getUserFollowing(address: String!, limit: Int): [User!]!
  getUsers(limit: Int, prefix: String!): [User!]!
}

type SocialLink {
  platform: String
  url: String
}

input SocialLinkInput {
  platform: String
  url: String
}

"""Unix epoch in milliseconds (number)."""
scalar Timestamp

input UpdatePostInput {
  cid: String
  content: String
  description: String
  postId: String!
  title: String
  visibility: VisibilitySetting
}

input UpdateUserInput {
  address: String!
  bio: String
  coverPicture: String
  displayName: String
  profilePicture: String
  socialLinks: [SocialLinkInput!]
  username: String
}

scalar Upload

type User {
  address: String!
  bio: String
  bookmarksCount: Int!
  coverPicture: String
  createdAt: Timestamp!
  displayName: String
  followersCount: Int!
  followingCount: Int!
  profilePicture: String
  publicationsCount: Int!
  socialLinks: [SocialLink]
  updatedAt: Timestamp!
  username: String
  verified: Boolean
}

input UserByInput {
  address: String
}

input UserInput {
  address: String!
  bio: String
  coverPicture: String
  displayName: String
  profilePicture: String
  socialLinks: [SocialLinkInput!]
  username: String
}

enum VisibilitySetting {
  FOLLOWERS_ONLY
  PRIVATE
  PUBLIC
}
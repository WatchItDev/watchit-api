directive @cacheControl(inheritMaxAge: Boolean, maxAge: Int, scope: CacheControlScope) on FIELD_DEFINITION | INTERFACE | OBJECT | UNION

input AgentInput {
  message: String!
}

type AgentOutput {
  done: Boolean
  message: Message
}

enum CacheControlScope {
  PRIVATE
  PUBLIC
}

"""A comment on a post, or a reply to another comment."""
type Comment {
  author: User!
  content: String!
  createdAt: Timestamp!
  hidden: Boolean!
  id: String!
  likeCount: Int!
  parentComment: Comment
  post: Post!
  repliesCount: Int!
  updatedAt: Timestamp!
}

input CreateCommentInput {
  content: String!
  parentComment: String
  postId: String!
}

input CreatePostInput {
  body: String!
  title: String!
  visibility: VisibilitySetting!
}

input CreateTipInput {
  amount: Float!
  creator: String!
  message: String
  postId: String!
  txHash: String
}

input CreateUserInput {
  address: String!
  bio: String!
  cover: String
  displayName: String!
  picture: String
  socialLinks: [SocialLinkInput!]
  username: String!
}

scalar Date

"""ISO-8601 Date-Time string (e.g. 2024-04-17T15:22:00.000Z)"""
scalar DateTime

type EventLog {
  amount: Int
  author: String
  createdAt: Timestamp!
  currency: String
  id: String!
  meta: JSON
  progress: Int
  targetId: String
  targetType: String
  type: String!
}

input FollowInput {
  targetAddress: String!
}

input HidePostInput {
  postId: String!
}

scalar JSON

input LikeInput {
  targetId: String!
  targetType: TargetType!
}

input LogEventInput {
  amount: Int
  currency: String
  meta: JSON
  progress: Int
  targetId: String
  targetType: String
  type: String!
}

type MediaAttachment {
  cid: String!
  id: Int!
  title: String
  type: String!
  url: String
}

type Message {
  content: String!
}

type Mutation {
  createComment(input: CreateCommentInput!): Comment!
  createPost(input: CreatePostInput!): Post!
  createTip(input: CreateTipInput!): Tip!
  createUser(input: CreateUserInput!): User!
  hideComment(commentId: String!): Boolean
  hidePost(input: HidePostInput!): Boolean
  humanMessage(input: AgentInput!): Message
  logAnonymousEvent(input: LogEventInput!): Boolean!
  logEvent(input: LogEventInput!): Boolean!
  toggleFollow(input: FollowInput!): Boolean!
  toggleLike(input: LikeInput!): Boolean!
  updateComment(input: UpdateCommentInput!): Comment!
  updatePost(input: UpdatePostInput!): Post!
  updateUser(input: UpdateUserInput!): User!
}

input PaginationInput {
  limit: Int
  offset: Int
}

type Post {
  active: Boolean!
  body: String!
  createdAt: Date!
  id: Int!
  title: String!
  user: User
  visibility: VisibilitySetting!
}

input PostByIdentifierInput {
  id: Int
}

input PostFilterInput {
  id: Int
  userId: Int
}

type Profile {
  bio: String!
  cover: String
  picture: String
  username: String!
}

type Query {
  getCommentsByPost(limit: Int, postId: String!): [Comment!]!
  getCreatorTips(address: String!, limit: Int): [Tip!]!
  getIsFollowing(targetAddress: String!): Boolean!
  getIsLiked(targetId: String!): Boolean!
  getPost(input: PostByIdentifierInput!): Post
  getPostViews(postId: String!): Int!
  getPosts(input: PostFilterInput!, pagination: PaginationInput): [Post!]!
  getProfileViews(address: String!): Int!
  getRepliesByComment(commentId: String!, limit: Int): [Comment!]!
  getTargetEvents(limit: Int = 50, offset: Int = 0, targetId: String!, targetType: String, type: String): [EventLog!]!
  getTipsByBakerForPost(limit: Int, postId: String!): [TipByBaker!]!
  getTipsForPost(limit: Int, postId: String!): [Tip!]!
  getUser(input: UserByIdentifierInput!): User
  getUserEvents(address: String!, limit: Int = 50, offset: Int = 0, type: String): [EventLog!]!
  getUserTipsHistory(address: String!, limit: Int): [Tip!]!
}

type SocialLink {
  platform: String!
  url: String!
}

input SocialLinkInput {
  platform: String!
  url: String!
}

input SocialsFilterInput {
  platform: String!
  userId: Int
}

type Subscription {
  onAiMessage: AgentOutput
}

enum TargetType {
  COMMENT
  POST
}

"""Unix epoch in milliseconds (number)."""
scalar Timestamp

type Tip {
  amount: Float!
  baker: String!
  createdAt: Timestamp!
  creator: String!
  id: String!
  message: String
  postId: String!
  txHash: String
}

type TipByBaker {
  baker: User!
  count: Float!
  lastTipAt: Timestamp!
  totalAmount: Float!
}

input UpdateCommentInput {
  commentId: String!
  content: String!
}

input UpdatePostInput {
  body: String
  postId: String!
  title: String
  visibility: VisibilitySetting
}

input UpdateUserInput {
  bio: String
  cover: String
  displayName: String
  picture: String
  socialLinks: [SocialLinkInput!]
  username: String
}

scalar Upload

type User {
  address: String!
  createdAt: Timestamp!
  displayName: String!
  email: String!
  id: Int!
  profile: Profile
  socialLinks: [SocialLink!]
  verified: Boolean!
}

input UserByIdentifierInput {
  address: String
  email: String
  id: Int
}

input UsersFilterInput {
  name: String
  verified: Boolean
}

enum VisibilitySetting {
  FOLLOWERS_ONLY
  PRIVATE
  PUBLIC
}
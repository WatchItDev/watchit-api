directive @cacheControl(inheritMaxAge: Boolean, maxAge: Int, scope: CacheControlScope) on FIELD_DEFINITION | INTERFACE | OBJECT | UNION

type Block {
  blocked: User!
  blockedAt: DateTime!
  blocker: User!
}

enum CacheControlScope {
  PRIVATE
  PUBLIC
}

type Comment {
  content: String!
  createdAt: DateTime!
  id: ID!
  post: Post!
  user: User!
}

type Conversation {
  id: ID!
  messages: [Message!]!
  participants: [User!]!
  updatedAt: DateTime!
}

scalar Date

scalar DateTime

input FilterInput {
  limit: Int
  offset: Int
}

type Follow {
  followed: User!
  followedAt: DateTime!
  follower: User!
}

scalar JSON

type MediaAttachment {
  id: ID!
  type: MediaType!
  url: String!
}

enum MediaType {
  AUDIO
  IMAGE
  VIDEO
}

type Message {
  content: String!
  createdAt: DateTime!
  id: ID!
  media: [MediaAttachment]
  read: Boolean!
  recipient: User!
  sender: User!
}

type Mutation {
  """
  Creates a new user profile based on the input data.
  Returns the recent created user.
  """
  CreateProfile(input: UserInput!): User!
}

type Mute {
  muted: User!
  mutedAt: DateTime!
  muter: User!
}

type Post {
  author: User!
  content: String!
  createdAt: DateTime!
  id: ID!
  media: [MediaAttachment!]
  quoteOf: Post
  replyTo: Post
  updatedAt: DateTime
  visibility: VisibilitySetting!
}

type Query

type Reaction {
  createdAt: DateTime!
  id: ID!
  post: Post!
  type: ReactionType!
  user: User!
}

enum ReactionType {
  BOOKMARK
  LIKE
  REPOST
}

scalar Upload

type User {
  avatarUrl: String
  bannerUrl: String
  bio: String
  createdAt: DateTime!
  displayName: String
  id: ID!
  updatedAt: DateTime!
  username: String!
  verified: Boolean
}

input UserByInput {
  address: String
}

input UserInput {
  address: String!
  username: String!
}

enum VisibilitySetting {
  FOLLOWERS_ONLY
  PRIVATE
  PUBLIC
}
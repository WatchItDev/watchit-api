directive @cacheControl(inheritMaxAge: Boolean, maxAge: Int, scope: CacheControlScope) on FIELD_DEFINITION | INTERFACE | OBJECT | UNION

enum CacheControlScope {
  PRIVATE
  PUBLIC
}

scalar Date

"""ISO‑8601 Date‑Time string (e.g. 2024‑04‑17T15:22:00.000Z)"""
scalar DateTime

input FilterInput {
  limit: Int
  offset: Int
}

scalar JSON

type Mutation {
  """
  Creates a new user profile based on the input data.
  Returns the recent created user.
  """
  createUser(input: UserInput!): User!

  """Update the current user with new metadata."""
  updateUser(input: UpdateUserInput!): User!
}

type Query {
  """Retrieve a single user by wallet address."""
  user(address: String!): User
}

type SocialLink {
  platform: String
  url: String
}

"""Simple key-value for social links (e.g. Twitter, GitHub)."""
input SocialLinkInput {
  platform: String
  url: String
}

"""Unix epoch in milliseconds (number)."""
scalar Timestamp

"""Input for updating a user."""
input UpdateUserInput {
  address: String!
  bio: String
  coverPicture: String
  displayName: String
  profilePicture: String
  socialLinks: [SocialLinkInput!]
  username: String
}

scalar Upload

type User {
  address: String!
  bio: String
  coverPicture: String
  createdAt: Int!
  displayName: String
  followersCount: Int!
  followingCount: Int!
  profilePicture: String
  publicationsCount: Int!
  socialLinks: [SocialLink]
  updatedAt: Int!
  username: String
  verified: Boolean
}

input UserByInput {
  address: String
}

input UserInput {
  address: String!
}
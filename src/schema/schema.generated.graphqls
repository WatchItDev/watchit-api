directive @cacheControl(inheritMaxAge: Boolean, maxAge: Int, scope: CacheControlScope) on FIELD_DEFINITION | INTERFACE | OBJECT | UNION

"""Bookmark / unbookmark a post."""
input BookmarkPostInput {
  postId: String!
}

enum CacheControlScope {
  PRIVATE
  PUBLIC
}

"""A comment on a post, or a reply to another comment."""
type Comment {
  author: User!
  content: String!
  createdAt: Timestamp!
  id: String!
  likeCount: Int!
  parentComment: Comment
  post: Post!
  updatedAt: Timestamp
}

input CreateCommentInput {
  authorAddress: String!
  content: String!
  parentComment: String
  postId: String!
}

input CreatePostInput {
  authorAddress: String!
  cid: String!
  content: String
  description: String!
  media: [MediaAttachmentInput!]
  quoteOf: String
  replyTo: String
  title: String!
  visibility: VisibilitySetting!
}

scalar Date

"""ISO‑8601 Date‑Time string (e.g. 2024‑04‑17T15:22:00.000Z)"""
scalar DateTime

input FilterInput {
  limit: Int
  offset: Int
}

"""Follow / unfollow someone."""
input FollowInput {
  targetAddress: String!
}

scalar JSON

"""Like / unlike a comment."""
input LikeCommentInput {
  commentId: String!
}

"""Like / unlike a post."""
input LikePostInput {
  postId: String!
}

"""An attachment in a post."""
type MediaAttachment {
  cid: String
  id: String
  title: String
  type: MediaType!
  url: String
}

input MediaAttachmentInput {
  cid: String
  title: String
  type: MediaType!
  url: String
}

enum MediaType {
  AUDIO
  IMAGE
  VIDEO
}

type Mutation {
  bookmarkPost(input: BookmarkPostInput!): Boolean!
  createComment(input: CreateCommentInput!): Comment!
  createPost(input: CreatePostInput!): Post!
  createUser(input: UserInput!): User!
  deleteComment(commentId: String!): Boolean!
  deletePost(postId: String!): Boolean!
  followUser(input: FollowInput!): Boolean!
  incrementPostView(postId: String!): Post!
  likeComment(input: LikeCommentInput!): Boolean!
  likePost(input: LikePostInput!): Boolean!
  unbookmarkPost(input: BookmarkPostInput!): Boolean!
  unfollowUser(input: FollowInput!): Boolean!
  unlikeComment(input: LikeCommentInput!): Boolean!
  unlikePost(input: LikePostInput!): Boolean!
  updateComment(input: UpdateCommentInput!): Comment!
  updatePost(input: UpdatePostInput!): Post!
  updateUser(input: UpdateUserInput!): User!
}

"""A user’s post/publication."""
type Post {
  author: User!
  bookmarkCount: Int!
  cid: String!
  commentCount: Int!
  content: String!
  createdAt: Timestamp!
  description: String!
  id: String!
  likeCount: Int!
  media: [MediaAttachment!]
  quoteOf: Post
  replyTo: Post
  title: String!
  updatedAt: Timestamp
  viewCount: Int!
  visibility: VisibilitySetting!
}

type Query {
  getActiveUsers(limit: Int): [User!]!
  getAllPosts(limit: Int): [Post!]!
  getCommentsByPost(limit: Int, postId: String!): [Comment!]!
  getIsFollowing(followerAddress: String!, targetAddress: String!): Boolean!
  getPopularPosts(limit: Int): [Post!]!
  getPopularUsers(limit: Int): [User!]!
  getPost(id: String!): Post
  getPostsByAuthor(author: String!, limit: Int): [Post!]!
  getRecentPosts(limit: Int): [Post!]!
  getRecentUsers(limit: Int): [User!]!
  getRepliesByComment(commentId: String!, limit: Int): [Comment!]!
  getUser(address: String!): User
  getUserBookmarks(address: String!, limit: Int): [Post!]!
  getUserFollowers(address: String!, limit: Int): [User!]!
  getUserFollowing(address: String!, limit: Int): [User!]!
  getUsers(limit: Int, prefix: String!): [User!]!
}

type SocialLink {
  platform: String
  url: String
}

input SocialLinkInput {
  platform: String
  url: String
}

"""Unix epoch in milliseconds (number)."""
scalar Timestamp

input UpdateCommentInput {
  commentId: String!
  content: String!
}

input UpdatePostInput {
  cid: String
  content: String
  description: String
  postId: String!
  title: String
  visibility: VisibilitySetting
}

input UpdateUserInput {
  address: String!
  bio: String
  coverPicture: String
  displayName: String
  profilePicture: String
  socialLinks: [SocialLinkInput!]
  username: String
}

scalar Upload

type User {
  address: String!
  bio: String
  bookmarksCount: Int!
  coverPicture: String
  createdAt: Timestamp!
  displayName: String
  followersCount: Int!
  followingCount: Int!
  profilePicture: String
  publicationsCount: Int!
  socialLinks: [SocialLink]
  updatedAt: Timestamp!
  username: String
  verified: Boolean
}

input UserByInput {
  address: String
}

input UserInput {
  address: String!
  bio: String
  coverPicture: String
  displayName: String
  profilePicture: String
  socialLinks: [SocialLinkInput!]
  username: String
}

enum VisibilitySetting {
  FOLLOWERS_ONLY
  PRIVATE
  PUBLIC
}
directive @cacheControl(inheritMaxAge: Boolean, maxAge: Int, scope: CacheControlScope) on FIELD_DEFINITION | INTERFACE | OBJECT | UNION

input AddXPInput {
  action: String!
  address: String!
  amount: Int!
  description: String!
}

input BookmarkPostInput {
  postId: String!
}

enum CacheControlScope {
  PRIVATE
  PUBLIC
}

"""A comment on a post, or a reply to another comment."""
type Comment {
  author: User!
  content: String!
  createdAt: Timestamp!
  hidden: Boolean!
  id: String!
  likeCount: Int!
  parentComment: Comment
  post: Post!
  updatedAt: Timestamp!
}

input CreateCommentInput {
  authorAddress: String!
  content: String!
  parentComment: String
  postId: String!
}

input CreatePostInput {
  authorAddress: String!
  cid: String!
  description: String!
  media: [MediaAttachmentInput!]!
  title: String!
  visibility: VisibilitySetting!
}

scalar Date

"""ISO-8601 Date-Time string (e.g. 2024-04-17T15:22:00.000Z)"""
scalar DateTime

input FilterInput {
  limit: Int
  offset: Int
}

input FollowInput {
  targetAddress: String!
}

scalar JSON

input LikeCommentInput {
  commentId: String!
}

input LikePostInput {
  postId: String!
}

type MediaAttachment {
  cid: String!
  id: String!
  title: String
  type: String!
  url: String
}

input MediaAttachmentInput {
  cid: String!
  title: String
  type: String!
  url: String
}

type Mutation {
  createComment(input: CreateCommentInput!): Comment!
  createPost(input: CreatePostInput!): Post!
  createUser(input: UserInput!): User!
  hideComment(commentId: String!): Boolean!
  hidePost(postId: String!): Boolean!
  incrementPostView(postId: String!): Post!
  toggleBookmark(input: BookmarkPostInput!): Boolean!
  toggleCommentLike(input: LikeCommentInput!): Boolean!
  toggleFollow(input: FollowInput!): Boolean!
  togglePostLike(input: LikePostInput!): Boolean!
  updateComment(input: UpdateCommentInput!): Comment!
  updatePost(input: UpdatePostInput!): Post!
  updateUser(input: UpdateUserInput!): User!
}

type Post {
  author: User!
  bookmarkCount: Int!
  cid: String!
  commentCount: Int!
  createdAt: Timestamp!
  description: String!
  hidden: Boolean!
  id: String!
  likeCount: Int!
  media: [MediaAttachment!]!
  title: String!
  updatedAt: Timestamp!
  viewCount: Int!
  visibility: VisibilitySetting!
}

type Query {
  getActiveUsers(limit: Int): [User!]!
  getAllPosts(limit: Int): [Post!]!
  getCommentsByPost(limit: Int, postId: String!): [Comment!]!
  getIsBookmarked(postId: String!): Boolean!
  getIsCommentLiked(commentId: String!): Boolean!
  getIsFollowing(followerAddress: String!, targetAddress: String!): Boolean!
  getIsPostLiked(postId: String!): Boolean!
  getPopularPosts(limit: Int): [Post!]!
  getPopularUsers(limit: Int): [User!]!
  getPost(id: String!): Post
  getPosts(limit: Int, query: String!): [Post!]!
  getPostsByAuthor(author: String!, limit: Int): [Post!]!
  getRecentPosts(limit: Int): [Post!]!
  getRecentUsers(limit: Int): [User!]!
  getRepliesByComment(commentId: String!, limit: Int): [Comment!]!
  getUser(address: String!): User
  getUserBookmarks(address: String!, limit: Int): [Post!]!
  getUserFollowers(address: String!, limit: Int): [User!]!
  getUserFollowing(address: String!, limit: Int): [User!]!
  getUserXPHistory(address: String!, limit: Int = 50, offset: Int = 0): [XPEntry!]!
  getUsers(limit: Int, query: String!): [User!]!
}

type SocialLink {
  platform: String!
  url: String!
}

input SocialLinkInput {
  platform: String!
  url: String!
}

"""Unix epoch in milliseconds (number)."""
scalar Timestamp

input UpdateCommentInput {
  commentId: String!
  content: String!
}

input UpdatePostInput {
  cid: String
  description: String
  media: [MediaAttachmentInput!]
  postId: String!
  title: String
  visibility: VisibilitySetting
}

input UpdateUserInput {
  address: String!
  bio: String
  coverPicture: String
  displayName: String
  profilePicture: String
  socialLinks: [SocialLinkInput!]
  username: String
}

scalar Upload

type User {
  address: String!
  bio: String!
  bookmarksCount: Int!
  coverPicture: String!
  createdAt: Timestamp!
  displayName: String!
  followersCount: Int!
  followingCount: Int!
  profilePicture: String!
  publicationsCount: Int!
  socialLinks: [SocialLink!]
  updatedAt: Timestamp!
  username: String!
  verified: Boolean!
  xpBalance: Int!
}

input UserByInput {
  address: String!
}

input UserInput {
  address: String!
  bio: String!
  coverPicture: String
  displayName: String!
  profilePicture: String
  socialLinks: [SocialLinkInput!]!
  username: String!
}

enum VisibilitySetting {
  FOLLOWERS_ONLY
  PRIVATE
  PUBLIC
}

type XPEntry {
  action: String!
  amount: Int!
  balanceAfter: Int!
  balanceBefore: Int!
  createdAt: Timestamp!
  description: String!
  id: ID!
}
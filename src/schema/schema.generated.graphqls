directive @cacheControl(inheritMaxAge: Boolean, maxAge: Int, scope: CacheControlScope) on FIELD_DEFINITION | INTERFACE | OBJECT | UNION

input AddXPInput {
  action: String!
  address: String!
  amount: Int!
  description: String!
}

input BookmarkInput {
  postId: String!
}

enum CacheControlScope {
  PRIVATE
  PUBLIC
}

"""A comment on a post, or a reply to another comment."""
type Comment {
  author: User!
  content: String!
  createdAt: Timestamp!
  hidden: Boolean!
  id: String!
  likeCount: Int!
  parentComment: Comment
  post: Post!
  repliesCount: Int!
  updatedAt: Timestamp!
}

input CreateCommentInput {
  content: String!
  parentComment: String
  postId: String!
}

input CreatePostInput {
  cid: String!
  description: String!
  media: [MediaAttachmentInput!]!
  title: String!
  visibility: VisibilitySetting!
}

scalar Date

"""ISO-8601 Date-Time string (e.g. 2024-04-17T15:22:00.000Z)"""
scalar DateTime

type EventLog {
  amount: Int
  author: String
  createdAt: Timestamp!
  currency: String
  id: String!
  meta: JSON
  progress: Int
  targetId: String
  targetType: String
  type: String!
}

type ExecutionRule {
  cooldownSec: Int!
  type: String!
}

input ExecutionRuleInput {
  cooldownSec: Int!
  type: String!
}

input FilterInput {
  limit: Int
  offset: Int
}

input FollowInput {
  targetAddress: String!
}

type GameConfig {
  cooldownSec: Int!
  id: ID!
  lockedUntilRank: String!
  version: Int!
}

type GuessMoviePayload {
  imageBlurUrl: String!
  nonce: String!
  options: [String!]!
  sessionId: String!
}

type GuessMovieResult {
  attemptsLeft: Int!
  correct: Boolean!
  finished: Boolean!
  xpAwarded: Int!
}

scalar JSON

type LeaderboardRow {
  rank: Int!
  user: User!
  xpTotal: Int!
}

input LikeInput {
  targetId: String!
  targetType: TargetType!
}

input LogEventInput {
  amount: Int
  currency: String
  meta: JSON
  progress: Int
  targetId: String
  targetType: String
  type: String!
}

type MediaAttachment {
  cid: String!
  id: String!
  title: String
  type: String!
  url: String
}

input MediaAttachmentInput {
  cid: String!
  title: String
  type: String!
  url: String
}

type Mutation {
  claimPerk(perkId: ID!): Boolean!
  createComment(input: CreateCommentInput!): Comment!
  createPerk(input: PerkInput!): Perk!
  createPost(input: CreatePostInput!): Post!
  createRank(input: RankInput!): Rank!
  createUser(input: UserInput!): User!
  deletePerk(id: ID!): Boolean!
  deleteRank(id: ID!): Boolean!
  hideComment(commentId: String!): Boolean
  hidePost(postId: String!): Boolean
  incrementPostView(postId: String!): Post!
  logAnonymousEvent(input: LogEventInput!): Boolean!
  logEvent(input: LogEventInput!): Boolean!
  spinDailyWheel: SpinResult!
  startGuessMovie: GuessMoviePayload!
  startTrivia(difficulty: Int = 1): TriviaQuestion!
  submitGuessMovie(answerIndex: Int!, sessionId: ID!): GuessMovieResult!
  submitTriviaAnswer(answerIndex: Int!, questionId: ID!, sessionId: ID!): TriviaAnswer!
  toggleBookmark(input: BookmarkInput!): Boolean!
  toggleFollow(input: FollowInput!): Boolean!
  toggleLike(input: LikeInput!): Boolean!
  updateComment(input: UpdateCommentInput!): Comment!
  updatePerk(id: ID!, patch: PerkInput!): Perk!
  updatePost(input: UpdatePostInput!): Post!
  updateRank(id: ID!, patch: RankInput!): Rank!
  updateUser(input: UpdateUserInput!): User!
}

type Perk {
  availableAt: Timestamp
  category: PerkCategory!
  collectedAt: Timestamp
  cooldownRemaining: Int!
  enabled: Boolean!
  executionRule: ExecutionRule!
  id: String!
  minRankId: String!
  name: String!
  reward: Reward!
  rewardPreview: String!
  uiHint: String
  unlockRule: UnlockRule!
}

enum PerkCategory {
  ACCESS
  ECONOMY
  GAMIFICATION
  SOCIAL
}

input PerkInput {
  category: PerkCategory!
  enabled: Boolean!
  executionRule: ExecutionRuleInput!
  id: String!
  minRankId: String!
  name: String!
  reward: RewardInput!
  uiHint: String
  unlockRule: UnlockRuleInput!
}

type Post {
  author: User!
  bookmarkCount: Int!
  cid: String!
  commentCount: Int!
  createdAt: Timestamp!
  description: String!
  hidden: Boolean!
  id: String!
  likeCount: Int!
  media: [MediaAttachment!]!
  title: String!
  updatedAt: Timestamp!
  viewCount: Int!
  visibility: VisibilitySetting!
}

type Query {
  getAchievements(address: String!): UserAchievements!
  getActiveUsers(limit: Int): [User!]!
  getAllPosts(limit: Int): [Post!]!
  getBookmarksByPost(limit: Int = 50, postId: String!): [User!]!
  getBookmarksByUser(address: String!, limit: Int = 50): [Post!]!
  getCommentsByPost(limit: Int, postId: String!): [Comment!]!
  getGamesAvailable(address: String!): [GameConfig!]!
  getIsBookmarked(postId: String!): Boolean!
  getIsFollowing(targetAddress: String!): Boolean!
  getIsLiked(targetId: String!): Boolean!
  getLeaderboard(limit: Int = 100): [LeaderboardRow!]!
  getPerks: [Perk!]!
  getPopularPosts(limit: Int): [Post!]!
  getPopularUsers(limit: Int): [User!]!
  getPost(id: String!): Post
  getPostViews(postId: String!): Int!
  getPosts(limit: Int, query: String!): [Post!]!
  getPostsByAuthor(author: String!, limit: Int): [Post!]!
  getProfileViews(address: String!): Int!
  getRanksCatalog: [Rank!]!
  getRecentPosts(limit: Int): [Post!]!
  getRecentUsers(limit: Int): [User!]!
  getRepliesByComment(commentId: String!, limit: Int): [Comment!]!
  getTargetEvents(limit: Int = 50, offset: Int = 0, targetId: String!, targetType: String, type: String): [EventLog!]!
  getUnlockedPerks(address: String!, limit: Int = 50, offset: Int = 0): [Perk!]!
  getUser(input: UserByInput!): User
  getUserBookmarks(address: String!, limit: Int): [Post!]!
  getUserEvents(address: String!, limit: Int = 50, offset: Int = 0, type: String): [EventLog!]!
  getUserFollowers(address: String!, limit: Int): [User!]!
  getUserFollowing(address: String!, limit: Int): [User!]!
  getUserRanks(address: String!): [UserRank!]!
  getUserXPHistory(address: String!, limit: Int = 50, offset: Int = 0): [XPEntry!]!
  getUsers(limit: Int, query: String!): [User!]!
}

type Rank {
  badgeUrl: String!
  colorTheme: String!
  createdAt: Timestamp!
  id: String!
  minXp: Int!
  name: String!
  order: Int!
  updatedAt: Timestamp!
}

input RankInput {
  badgeUrl: String!
  colorTheme: String!
  id: String!
  minXp: Int!
  name: String!
  order: Int!
}

type Reward {
  action: String!
  amount: Int
  tokenId: String
}

input RewardInput {
  action: String!
  amount: Int
  tokenId: String
}

type SocialLink {
  platform: String!
  url: String!
}

input SocialLinkInput {
  platform: String!
  url: String!
}

type SpinResult {
  cooldownUntil: Timestamp!
  emoji: String!
  label: String!
  outcomeId: String!
  rewardApplied: Boolean!
}

enum TargetType {
  COMMENT
  POST
}

"""Unix epoch in milliseconds (number)."""
scalar Timestamp

type TriviaAnswer {
  correct: Boolean!
  finished: Boolean!
  nextQuestion: TriviaQuestion
  xpAwarded: Int!
}

type TriviaQuestion {
  image: String
  nonce: String!
  options: [String!]!
  questionId: String!
  sessionId: String!
  text: String!
}

type UnlockRule {
  action: String
  on: String!
  rankId: String
  times: Int
  window: String
}

input UnlockRuleInput {
  action: String
  on: String!
  rankId: String
  times: Int
  window: String
}

input UpdateCommentInput {
  commentId: String!
  content: String!
}

input UpdatePostInput {
  cid: String
  description: String
  media: [MediaAttachmentInput!]
  postId: String!
  title: String
  visibility: VisibilitySetting
}

input UpdateUserInput {
  bio: String
  coverPicture: String
  displayName: String
  profilePicture: String
  socialLinks: [SocialLinkInput!]
  username: String
}

scalar Upload

type User {
  address: String!
  bio: String!
  bookmarksCount: Int!
  coverPicture: String!
  createdAt: Timestamp!
  currentRank: String!
  displayName: String!
  email: String!
  followersCount: Int!
  followingCount: Int!
  id: String!
  profilePicture: String!
  publicationsCount: Int!
  socialLinks: [SocialLink!]
  updatedAt: Timestamp!
  username: String!
  verified: Boolean!
  xpBalance: Int!
  xpTotal: Int!
}

type UserAchievements {
  currentRank: Rank!
  nextRank: Rank
  progressPct: Float!
  xpBalance: Int!
  xpRemaining: Int!
  xpTotal: Int!
}

input UserByInput {
  address: String!
  idSession: String
}

input UserInput {
  address: String!
  bio: String!
  coverPicture: String
  displayName: String!
  profilePicture: String
  socialLinks: [SocialLinkInput!]
  username: String!
}

type UserRank {
  achievedAt: Timestamp!
  rankId: String!
  user: String!
}

enum VisibilitySetting {
  FOLLOWERS_ONLY
  PRIVATE
  PUBLIC
}

type XPEntry {
  action: String!
  amount: Int!
  balanceAfter: Int!
  balanceBefore: Int!
  createdAt: Timestamp!
  description: String!
  id: ID!
  totalAfter: Int!
  user: String!
}
model Social {
    id       Int    @id @default(autoincrement())
    userId   Int
    platform String
    url      String

    user User @relation(fields: [userId], references: [id])

    @@index([platform(sort: Asc)])

    @@map("socials")
}

model Profile {
    id       Int     @id @default(autoincrement())
    userId   Int     @unique
    username String  @unique
    bio      String
    picture  String?
    cover    String?

    user User @relation(fields: [userId], references: [id])

    @@index([username(sort: Asc)])

    @@map("profile")
}

model User {
    id          Int      @id @default(autoincrement())
    email       String   @unique
    address     String   @unique
    displayName String
    verified    Boolean  @default(false)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    profile      Profile?
    socials      Social[]
    contents     Content[]
    reactions    Reaction[]
    // bookmarks    Bookmarks[]
    transactions Transaction[]
    from         Edge[]     @relation("UserFrom")
    to           Edge[]     @relation("UserTo")

    @@index([email])
    @@index([address, email])

    @@map("users")
}

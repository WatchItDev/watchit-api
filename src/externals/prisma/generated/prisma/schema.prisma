generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("API_DATABASE_URL")
}

model Attachment {
  id     Int    @id @default(autoincrement())
  postId Int
  url    String
  cid    String @unique
  title  String
  type   String

  post Post @relation(fields: [postId], references: [id])

  @@index([cid])
  @@index([postId])
  @@map("attachments")
}

model Post {
  id        Int    @id @default(autoincrement())
  title     String
  body      String
  contentId Int    @unique

  comments    Comment[]
  attachments Attachment[]
  base        Content      @relation(fields: [contentId], references: [id])

  @@index([contentId])
  @@map("posts")
}

enum ReactionType {
  HATE
  LIKE
  LOVE
}

model Reaction {
  id        Int          @id @default(autoincrement())
  kind      ReactionType @default(LIKE)
  userId    Int
  contentId Int
  createdAt DateTime     @default(now())

  user    User    @relation(fields: [userId], references: [id])
  content Content @relation(fields: [contentId], references: [id])

  @@unique([userId, contentId])
  @@index([contentId])
  @@index([userId])
  @@index([kind])
  @@map("reactions")
}

enum TxType {
  DEPOSIT
  WITHDRAW
  TRADE
  TIP
}

model Transaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  type        TxType
  amount      Float
  balance     Float
  currency    String
  description String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([currency])
  @@index([type])
  @@map("transactions")
}

model Social {
  id       Int    @id @default(autoincrement())
  userId   Int
  platform String
  url      String

  user User @relation(fields: [userId], references: [id])

  @@index([platform(sort: Asc)])
  @@map("socials")
}

model Profile {
  id       Int     @id @default(autoincrement())
  userId   Int     @unique
  username String  @unique
  bio      String
  picture  String?
  cover    String?

  user User @relation(fields: [userId], references: [id])

  @@index([username(sort: Asc)])
  @@map("profile")
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  address     String   @unique
  displayName String
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile      Profile?
  socials      Social[]
  contents     Content[]
  reactions    Reaction[]
  // bookmarks    Bookmarks[]
  transactions Transaction[]
  from         Edge[]        @relation("UserFrom")
  to           Edge[]        @relation("UserTo")

  @@index([email])
  @@index([address, email])
  @@map("users")
}

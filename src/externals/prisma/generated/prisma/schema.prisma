model Comment {
  id        Int    @id @default(autoincrement())
  body      String
  postId    Int
  contentId Int    @unique
  parentId  Int?

  post          Post      @relation(fields: [postId], references: [id])
  base          Content   @relation(fields: [contentId], references: [id])
  parent        Comment[] @relation("CommentReply")
  parentComment Comment?  @relation("CommentReply", fields: [parentId], references: [id])
}

enum Visibility {
  PUBLIC
  FOLLOWERS_ONLY
  PRIVATE
}

enum ContentKind {
  POST
  COMMENT
}

model Content {
  id         Int         @id @default(autoincrement())
  userId     Int
  tags       Json?
  active     Boolean     @default(true)
  kind       ContentKind @default(POST)
  visibility Visibility  @default(PUBLIC)
  createdAt  DateTime    @default(now())

  post      Post?
  comment   Comment?
  reactions Reactions[]
  user      User        @relation(fields: [userId], references: [id])

  @@index([kind])
  @@map("Content")
}


model Comment {
  id        Int    @id @default(autoincrement())
  body      String
  postId    Int
  contentId Int    @unique
  parentId  Int?

  post          Post      @relation(fields: [postId], references: [id])
  base          Content   @relation(fields: [contentId], references: [id])
  parent        Comment[] @relation("CommentReply")
  parentComment Comment?  @relation("CommentReply", fields: [parentId], references: [id])

  @@index([postId])
  @@index([contentId])
  @@index([parentId])
  @@map("comments")
}

enum Visibility {
  PUBLIC
  FOLLOWERS_ONLY
  PRIVATE
}

enum ContentKind {
  POST
  COMMENT
}

model Content {
  id         Int         @id @default(autoincrement())
  userId     Int
  tags       Json?
  active     Boolean     @default(true)
  kind       ContentKind @default(POST)
  visibility Visibility  @default(PUBLIC)
  createdAt  DateTime    @default(now())

  post      Post?
  comment   Comment?
  reactions Reaction[]
  user      User       @relation(fields: [userId], references: [id])

  @@index([kind])
  @@index([userId])
  @@map("content")
}

enum EdgeState {
  NONE
  FOLLOW
  BLOCK
}

model Edge {
  fromUserId  Int
  toUserId    Int
  state       EdgeState @default(NONE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  preferences Json? // { "mute": true, "notifications": false }

  from User @relation("UserFrom", fields: [fromUserId], references: [id])
  to   User @relation("UserTo", fields: [toUserId], references: [id])

  @@id([fromUserId, toUserId])
  @@index([state])
  @@index([toUserId, state])
  @@index([fromUserId, state])
  @@map("edges")
}


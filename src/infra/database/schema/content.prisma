enum Visibility {
    PUBLIC
    FOLLOWERS_ONLY
    PRIVATE
}

enum ContentKind {
    POST
    COMMENT
}

model Content {
    id         Int         @id @default(autoincrement())
    userId     Int
    tags       Json?
    active     Boolean     @default(true)
    kind       ContentKind @default(POST)
    visibility Visibility  @default(PUBLIC)
    createdAt  DateTime    @default(now())

    post      Post?
    comment   Comment?
    reactions Reaction[]
    user      User       @relation(fields: [userId], references: [id])

    @@index([kind])
    @@index([userId])
    
    @@map("content")
}

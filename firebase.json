{
  "functions": {
    "source": "src/functions",
    "runtime": "nodejs20",
    "ignore": [
      "node_modules",
      ".git",
      "credentials/**"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "emulators": {
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "pubsub":    { "port": 8085 },
    "ui": {
      "enabled": true,
      "port": 4001
    }
  }
}
